---
import { Image } from 'astro:assets';
import { getCardImage } from '../lib/gallery';
import { getArticleVideo } from '../lib/video';
import { generateHeadlineExcerpts } from '../lib/excerpt';
import { hashArticleId } from '../lib/hash';
import { CATEGORIES, type CategoryKey } from '../lib/categories';

interface ArticleLike {
  id: string;
  body?: string;
  data: { title: string; date: Date; author: string; classImage?: any; classImageAlt?: string; videoUrl?: string };
}

interface Props {
  label: string;
  slug: string;
  /** Already sorted newest-first. The first entry becomes the large feature; up to four
   *  more are listed below it, in the same chronological order. */
  articles: ArticleLike[];
}

const { label, slug, articles } = Astro.props;
const [hero, ...rest] = articles;
const listItems = rest.slice(0, 4);

function articleHref(id: string): string {
  return `/${slug}/?${CATEGORIES[slug as CategoryKey].paramName}=${hashArticleId(slug, id)}`;
}

function resolveThumb(article: ArticleLike) {
  const video = getArticleVideo(slug, article.id, article.data.videoUrl);
  const thumb = getCardImage(slug, article.id, article.data.classImage) || video?.thumbnailUrl;
  return { video, thumb, isRemote: typeof thumb === 'string' };
}

const heroResolved = hero ? resolveThumb(hero) : null;
const heroExcerpt = hero ? generateHeadlineExcerpts(hero.data.title, hero.body).title : undefined;
const heroDate = hero
  ? hero.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : '';
---
{hero && (
  <div class="feature-column">
    <div class="feature-column-head">
      <a href={`/${slug}`} class="feature-column-label">{label}</a>
      <span class="feature-column-line" aria-hidden="true"></span>
    </div>

    <a href={articleHref(hero.id)} class="feature-hero">
      <div class="feature-hero-thumb" aria-hidden={!heroResolved?.thumb}>
        {heroResolved?.thumb ? (
          heroResolved.isRemote ? (
            <img src={heroResolved.thumb as string} alt="" width={480} height={320} class="feature-hero-img" loading="lazy" />
          ) : (
            <Image src={heroResolved.thumb as any} alt="" width={480} height={320} class="feature-hero-img" />
          )
        ) : (
          <span class="feature-thumb-glyph">§</span>
        )}
        {heroResolved?.video && (
          <span class="feature-play" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
        )}
        <div class="feature-hero-overlay">
          <h3 class="feature-hero-title">{heroExcerpt || hero.data.title}</h3>
          <p class="feature-hero-meta">{heroDate}</p>
        </div>
      </div>
    </a>

    {listItems.length > 0 && (
      <div class="feature-list">
        {listItems.map((article) => {
          const { thumb, video, isRemote } = resolveThumb(article);
          const { title: itemExcerpt } = generateHeadlineExcerpts(article.data.title, article.body);
          const itemDate = article.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
          return (
            <a href={articleHref(article.id)} class="feature-list-item">
              <span class="feature-thumb" aria-hidden={!thumb}>
                {thumb ? (
                  isRemote ? (
                    <img src={thumb as string} alt="" width={96} height={96} class="feature-thumb-img" loading="lazy" />
                  ) : (
                    <Image src={thumb as any} alt="" width={96} height={96} class="feature-thumb-img" />
                  )
                ) : (
                  <span class="feature-thumb-glyph">§</span>
                )}
                {video && (
                  <span class="feature-play feature-play-sm" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </span>
                )}
              </span>
              <span class="feature-copy">
                <span class="feature-item-title">{itemExcerpt || article.data.title}</span>
                <span class="feature-item-meta">{itemDate}</span>
              </span>
            </a>
          );
        })}
      </div>
    )}
  </div>
)}

<style>
  .feature-column {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .feature-column-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
  }

  .feature-column-label {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-2);
    padding: 6px 12px;
    border: 1px solid var(--brand-glow);
    border-radius: var(--radius-sm);
    background: var(--bg-sunken);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .feature-column-label:hover {
    color: var(--brand-1);
    border-color: var(--brand-2);
  }

  .feature-column-line {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .feature-hero {
    display: block;
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--line);
    margin-bottom: 18px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-hero:hover {
    border-color: var(--brand-2);
    box-shadow: var(--shadow-soft);
  }

  .feature-hero-thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-hero-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 40px 16px 14px;
    background: linear-gradient(180deg, rgba(6, 3, 12, 0) 0%, rgba(6, 3, 12, 0.85) 55%, rgba(6, 3, 12, 0.92) 100%);
  }

  .feature-hero-title {
    color: #fff;
    font-size: var(--text-md);
    line-height: 1.3;
    margin: 0 0 6px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .feature-hero-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: rgba(255, 255, 255, 0.75);
  }

  .feature-thumb-glyph {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
  }

  .feature-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
  }

  .feature-play-sm {
    width: 22px;
    height: 22px;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .feature-list-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .feature-thumb {
    position: relative;
    flex-shrink: 0;
    width: 64px;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 1px;
  }

  .feature-item-title {
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s ease;
  }

  .feature-list-item:hover .feature-item-title {
    color: var(--brand-2);
  }

  .feature-item-meta {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-soft);
  }
</style>
