---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  excerpt?: string;
  date: Date;
  author: string;
  href: string;
  categoryLabel?: string;
  size?: 'default' | 'compact';
  image?: ImageMetadata | string;
  imageAlt?: string;
  isVideo?: boolean;
}

const { title, excerpt, date, author, href, categoryLabel, size = 'default', image, imageAlt, isVideo = false } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const isRemoteImage = typeof image === 'string';
---
<a href={href} class:list={['card', size]}>
  <div class="card-thumb" aria-hidden={!image}>
    {image ? (
      isRemoteImage ? (
        <img src={image} alt={imageAlt || ''} width={480} height={270} class="thumb-img" loading="lazy" />
      ) : (
        <Image src={image} alt={imageAlt || ''} width={480} height={270} class="thumb-img" />
      )
    ) : (
      <span class="thumb-glyph">§</span>
    )}
    {isVideo && (
      <span class="play-badge" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </span>
    )}
  </div>
  <div class="card-body">
    {categoryLabel && <span class="eyebrow">{categoryLabel}</span>}
    <h3 class="card-title">{title}</h3>
    {excerpt && <p class="card-excerpt">{excerpt}</p>}
    <p class="card-meta">{author} · {formattedDate}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, var(--transition-theme);
    height: 100%;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--brand-2);
    box-shadow: var(--shadow-soft);
  }

  .card-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-badge {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .thumb-glyph {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    color: rgba(255,255,255,0.85);
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .card-title {
    font-size: var(--text-base);
    line-height: 1.3;
    margin-top: 2px;
  }

  .card-excerpt {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    margin: auto 0 0;
    padding-top: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    opacity: 0.8;
  }

  .card.compact .card-thumb { aspect-ratio: 16 / 10; }
  .card.compact .card-title { font-size: var(--text-md); }
</style>
