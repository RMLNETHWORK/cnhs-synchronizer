---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import CategoryFeatureColumn from '../components/CategoryFeatureColumn.astro';
import { CATEGORY_ORDER, CATEGORIES } from '../lib/categories';
import { getGalleryImages, getCardImage } from '../lib/gallery';
import { getArticleVideo } from '../lib/video';
import { generateExcerpt, generateHeadlineExcerpts } from '../lib/excerpt';
import { hashArticleId } from '../lib/hash';
import { recordView, type ViewsKV } from '../lib/views';
import { env } from 'cloudflare:workers';

interface Props {
  entry: any;
  category: keyof typeof CATEGORIES;
}

const { entry, category } = Astro.props;
const meta = CATEGORIES[category];

// Counts this render toward the article's popularity (see src/lib/views.ts and the "Sort by"
// control on /search). Fire-and-forget via Astro.locals.cfContext.waitUntil so a KV write
// never delays the response; falls through harmlessly if the VIEWS binding isn't configured
// (see env.d.ts) — recordView() no-ops on an undefined kv rather than throwing.
//
// Important: waitUntil is called as `cfContext.waitUntil(...)`, never detached into its own
// variable first. It's a native Cloudflare binding — pulling it off its object loses the
// `this` it needs internally and throws "Illegal invocation" at request time.
const kv = (env as { VIEWS?: ViewsKV }).VIEWS;
const cfContext = Astro.locals.cfContext;
const viewPromise = recordView(kv, category, entry.id);
if (cfContext) cfContext.waitUntil(viewPromise);
else viewPromise.catch(() => {});

/** Builds this category's `/<slug>/?<paramName>=<hash>` article URL for any entry in it. */
function articleHref(cat: keyof typeof CATEGORIES, id: string): string {
  return `/${CATEGORIES[cat].slug}/?${CATEGORIES[cat].paramName}=${hashArticleId(cat, id)}`;
}

const galleryImages = getGalleryImages(category, entry.id);
const { Content } = await render(entry);
const videoInfo = getArticleVideo(category, entry.id, entry.data.videoUrl);

// Sidebar rail: latest articles from this same category, shown alongside the article body.
const siblings = (await getCollection(category, ({ data }) => !data.draft))
  .filter((a) => a.id !== entry.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

// Full-width "other sections" block below the gallery: every other category, in the same
// order the nav and footer list them, each rendered the same way the homepage does it.
const otherCategoryData = await Promise.all(
  CATEGORY_ORDER.filter((key) => key !== category).map(async (key) => {
    const entries = (await getCollection(key, ({ data }) => !data.draft))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
      .slice(0, 5);
    return { key, entries };
  })
);

const formattedDate = entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const metaDescription = generateExcerpt(entry.data.title, entry.body);
const canonicalUrl = new URL(articleHref(category, entry.id), Astro.site).toString();
---
<BaseLayout title={entry.data.title} description={metaDescription} canonicalUrl={canonicalUrl} type="article">
  <article class="article">
    <div class:list={['wrap', 'article-head', { 'has-image': !!entry.data.classImage && !videoInfo }]}>
      <div class="article-head-copy">
        <a href={`/${meta.slug}`} class="back-link">← {meta.label}</a>
        <h1 class="article-title">{entry.data.title}</h1>
        <p class="article-meta">By {entry.data.author} · {formattedDate} · <span class="eyebrow">{meta.label}</span></p>
      </div>

      {!videoInfo && entry.data.classImage && (
        <div class="article-head-image">
          <Image src={entry.data.classImage} alt={entry.data.classImageAlt || ''} width={640} height={640} class="article-banner" />
        </div>
      )}
    </div>

    {videoInfo && (
      <div class="wrap article-video">
        <VideoEmbed info={videoInfo} title={entry.data.title} />
      </div>
    )}

    <div class="wrap article-content">
      <div class="article-main">
        <div class="article-body">
          <Content />
        </div>

        <Gallery images={galleryImages} />
      </div>

      {siblings.length > 0 && (
        <aside class="article-sidebar" aria-labelledby="sidebar-heading">
          <h2 id="sidebar-heading" class="sidebar-title">More in {meta.label}</h2>
          <div class="sidebar-list">
            {siblings.map((article) => {
              const siblingVideo = getArticleVideo(category, article.id, article.data.videoUrl);
              const siblingThumb = getCardImage(category, article.id, article.data.classImage) || siblingVideo?.thumbnailUrl;
              const isRemoteThumb = typeof siblingThumb === 'string';
              const { title: siblingTitle } = generateHeadlineExcerpts(article.data.title, article.body);
              const siblingDate = article.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
              return (
                <a href={articleHref(category, article.id)} class="sidebar-item">
                  <span class="sidebar-thumb" aria-hidden={!siblingThumb}>
                    {siblingThumb ? (
                      isRemoteThumb ? (
                        <img src={siblingThumb as string} alt="" width={96} height={96} class="sidebar-thumb-img" loading="lazy" />
                      ) : (
                        <Image src={siblingThumb as any} alt="" width={96} height={96} class="sidebar-thumb-img" />
                      )
                    ) : (
                      <span class="sidebar-thumb-glyph">§</span>
                    )}
                    {siblingVideo && (
                      <span class="sidebar-play" aria-hidden="true">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                      </span>
                    )}
                  </span>
                  <span class="sidebar-copy">
                    <span class="sidebar-item-title">{siblingTitle || article.data.title}</span>
                    <span class="sidebar-item-meta">{siblingDate}</span>
                  </span>
                </a>
              );
            })}
          </div>
        </aside>
      )}
    </div>
  </article>

  <section class="more-sections">
    <div class="wrap more-sections-grid">
      {otherCategoryData.map(({ key, entries }) => (
        <CategoryFeatureColumn label={CATEGORIES[key].label} slug={CATEGORIES[key].slug} articles={entries} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .article-head {
    padding-block: 36px 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
  }

  .article-head.has-image {
    grid-template-columns: 1.3fr 0.7fr;
  }

  .article-head-copy {
    max-width: 700px;
  }

  .article-head-image {
    display: flex;
    justify-content: flex-end;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    margin-bottom: 18px;
    transition: color 0.15s ease;
  }

  .back-link:hover { color: var(--brand-2); }

  .article-title {
    font-size: clamp(28px, 4.4vw, 42px);
    line-height: 1.15;
    margin: 10px 0 14px;
  }

  .article-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    margin: 0;
  }

  .article-banner {
    width: 100%;
    max-width: 480px;
    max-height: 206px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }

  .article-video {
    max-width: 900px;
    margin: 20px auto 0;
  }

  /* The divider between the head and the body+sidebar row now lives on this wrapper, so it
     spans the full width of both columns instead of just the article body. */
  .article-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
    border-top: 1px solid var(--line);
    margin-top: 28px;
    padding-block: 28px 56px;
  }

  .article-main {
    min-width: 0;
    max-width: 700px;
  }

  .article-body {
    font-size: var(--text-lg);
    line-height: 1.75;
  }

  .article-body :global(p) {
    margin: 0 0 22px;
  }

  .article-body :global(h2) {
    font-size: var(--text-2xl);
    margin: 36px 0 14px;
  }

  .article-sidebar {
    position: sticky;
    top: 24px;
  }

  .sidebar-title {
    font-size: var(--text-xl);
    margin: 0 0 18px;
  }

  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sidebar-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .sidebar-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .sidebar-thumb {
    position: relative;
    flex-shrink: 0;
    width: 84px;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sidebar-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sidebar-thumb-glyph {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
  }

  .sidebar-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .sidebar-copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 2px;
  }

  .sidebar-item-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s ease;
  }

  .sidebar-item:hover .sidebar-item-title {
    color: var(--brand-2);
  }

  .sidebar-item-meta {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-soft);
  }

  .more-sections {
    border-top: 1px solid var(--line);
    padding-block: 40px 56px;
  }

  .more-sections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  @media (max-width: 900px) {
    .more-sections-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 600px) {
    .more-sections-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .article-content {
      grid-template-columns: minmax(0, 1fr);
    }

    .article-main {
      max-width: none;
    }

    .article-sidebar {
      position: static;
      border-top: 1px solid var(--line);
      padding-top: 32px;
    }
  }

  @media (max-width: 760px) {
    .article-head.has-image {
      grid-template-columns: 1fr;
    }
    .article-head-image {
      justify-content: flex-start;
      order: -1;
    }
    .article-banner {
      max-width: 90vw;
      max-height: 260px;
    }
  }
</style>